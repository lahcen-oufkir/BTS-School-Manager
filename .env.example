# Docker Compose production environment
# Copy to .env and fill in real secrets before `docker compose up -d --build`.

# Backend
APP_KEY=base64:CHANGE_ME            # generate with: docker compose run --rm backend php artisan key:generate
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# Database
DB_CONNECTION=pgsql
DB_HOST=database
# Internal container port (fixed to 5432 in compose); DB_PORT below maps the host port.
DB_DATABASE=bts_school
DB_USERNAME=bts
# REQUIRED: set a strong password
DB_PASSWORD=CHANGE_ME

# Cache / Queue
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# REQUIRED: set a strong password
REDIS_PASSWORD=CHANGE_ME

# CORS (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
# Public URL of the backend API as seen by the browser (use your domain in production).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Host port mappings
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000